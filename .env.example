# ============================================================================
# GIULIA BEAUTY STUDIO — NODE.JS + MYSQL CONFIGURATION
# Copia questo file in .env (fuori da Git) su cPanel o in locale
# ============================================================================

PORT=3000
NODE_ENV=production

# Database MySQL su cPanel
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nomeutente_giulia_beauty
DB_USER=nomeutente_dbuser
DB_PASS=INSERISCI_PASSWORD_DB

# Sicurezza Sessioni & GDPR Audit (usa stringhe lunghe casuali in produzione)
SESSION_SECRET=cambia-questa-chiave-segreta-con-almeno-32-caratteri-casuali
IP_HASH_SALT=cambia-questo-salt-casuale-per-hash-ip-gdpr
PRIVACY_VERSION=v2.0-2026-11

# Imposta true se il sito è servito in HTTPS (es. su cPanel con SSL attivo)
COOKIE_SECURE=false
TRUST_PROXY=true

# Origini consentite per richieste cross-origin (separate da virgola, opzionale se stesso dominio)
ALLOWED_ORIGINS=https://giuliabeautystudio.it,https://www.giuliabeautystudio.it,https://tenday.github.io
